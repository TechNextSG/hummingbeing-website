{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/tre", "destination": "/tre-certification.html", "permanent": true },
    { "source": "/tre/", "destination": "/tre-certification.html", "permanent": true },
    { "source": "/tre.html", "destination": "/tre-certification.html", "permanent": true },
    { "source": "/somatic-coaching", "destination": "/holistic-mastermind.html", "permanent": true },
    { "source": "/somatic-coaching/", "destination": "/holistic-mastermind.html", "permanent": true },
    { "source": "/somatic-coaching.html", "destination": "/holistic-mastermind.html", "permanent": true },
    { "source": "/somatic-bodywork", "destination": "/holistic-mastermind.html", "permanent": true },
    { "source": "/somatic-bodywork/", "destination": "/holistic-mastermind.html", "permanent": true },
    { "source": "/somatic-bodywork.html", "destination": "/holistic-mastermind.html", "permanent": true },
    { "source": "/somatic-healing", "destination": "/holistic-mastermind.html", "permanent": true },
    { "source": "/somatic-healing/", "destination": "/holistic-mastermind.html", "permanent": true },
    { "source": "/somatic-healing.html", "destination": "/holistic-mastermind.html", "permanent": true },
    { "source": "/isabelle/", "destination": "/isabelle.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
